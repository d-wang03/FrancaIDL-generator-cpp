package fdmodel2

typeCollection tc1 {
    version {major 1 minor 0}
    
    struct a1{
        String str
        Boolean bool
    }
    struct tcStruct {
        Integer id
        String name
    }
    union u1 {
        Integer num
        Boolean ifcheck
    }
    enumeration e1 {
        FIRST
        SECOND
        THIRD
    }
    map tcMap { String to u1}
    array tcArray of a1
    typedef Order is e1
    
}

interface interface1{
    version {major 1 minor 0}

    attribute Float throttle
    attribute Float speed readonly
    struct a2{
        String str
        tc1.a1 testtc
    } 
    array Names of String

}


package com.bst.os.services.hello 


interface HelloService {
    version { major 2 minor 0 }
    
    attribute String name 
    attribute UInt32 position noSubscriptions 
    attribute Boolean status readonly
    method openCamera {
        in {
            UInt32 cameraID
            Boolean ifConfig
        }
        out {
            UInt32 openStatus
            Boolean isWrong
         }
    }

    method startRecord {
        in {
            String path
        }
    }

    method stopRecord {

    }

    method readRecord {
        in {
            String path
        }
    }

    broadcast firstBc selective {
        out {
            String hi
        }
   	
    }

    broadcast secondBc {
        out {
            String bye
        }
    }

}

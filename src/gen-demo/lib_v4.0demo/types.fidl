
package com.bst.os.idl.libtest

typeCollection libTypes {
    version { major 4 minor 0 }

	enumeration Grade {
		A_Grade
		B_Grade
		C_Grade
        D_Grade
        E_Grade
        F_Grade
	}

    enumeration MBTI {
        ISTJ = 0
        ISFJ = 1
        INTJ = 2
        INFJ = 3
        ISTP = 4
        ISFP = 5
        INTP = 6
        INFP = 7
        ESTJ = 8
        ESFJ = 9
        ENTJ = 10
        ENFJ = 11
        ESTP = 12
        ESFP = 13
        ENTP = 14
        ENFP = 15

    }

    struct StaffInfor {
        String lastName
        String firstName
        MBTI mbtiType
        ByteBuffer email
        ByteBuffer phoneCall
    }

    struct StaffStatus {
        Boolean isOff     
    }

    struct Performance {
        UInt64 salary
        Grade selfGrade
        Grade averageGrade
    }

    struct Staff {
        UInt64 id
        StaffInfor infor
        StaffStatus status
        Performance perform
    }

}
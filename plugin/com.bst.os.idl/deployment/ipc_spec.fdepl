//platform:/plugin/com.bst.ipc/deployment/ipc_spec.fdepl
specification com.bst.ipc.deployment{
    // provider为server或者client
    // 在同一个fdepl中，可以声明多个provider，分别对应不同的server和client。
    for providers {
        // provider类型，Client或者Server
        ProviderType : {Client, Server};
        //生成代码的运行环境，类型为枚举，默认为Posix。
        RTE : { Posix, BareMetal, LinuxKernel, RTOS} (default : Posix);
        //该server或client对应的msgEnd ID。
        SrcEndID : { CPU_0,CPU_1, CPU_2, CPU_3, CPU_4, CPU_5, CPU_6, CPU_7, CPUMP2_0, CPUMP2_1, ISPCV_0, ISPCV_1, ISPCV_2, ISPCV_3, ISPCV_4, NET_0, DMA_0, DMA_1, SWITCH_0, SWITCH_1, SWITCH_2, SWITCH_3, SWITCH_4, SWITCH_5, SECURE_0, SECURE_1, SAFETY_0, SAFETY_1, REALTIME_0, REALTIME_1, REALTIME_2, REALTIME_3, REALTIME_4, REALTIME_5, MEDIA_0};
        //过滤器ID，静态配置消息分发所属的过滤器
        //不同EndID，所拥有的过滤器数量不等，CPU为Default+7，DB为Default+1，其它均为Default+3。
        FID: { DEF, F1, F2, F3, F4, F5, F6, F7 } (default : DEF);
        //会话ID，静态配置通讯所使用的会话ID, 范围为0-15。
        //{EndID, FID, SID}三元组唯一。 
        SID: UInt8;
        //生成多线程分发器，仅适用于Posix环境，需要仔细测试多线程带来的收益。
        EnableMultiThreadDispatcher : Boolean (default : false);
        //Method消息分器线程数量，仅用于Server中
        MethodDispatcherNum : UInt8 (default : 8);
        //Method消息分发器缓存深度
        MethodDispatcherBufferLength : UInt16 (default : 512);
        //Reply消息分器线程数量，仅用于Client中
        ReplyDispatcherNum : UInt8 (default : 4);
        //Reply消息分发器缓存深度
        ReplyDispatcherBufferLength : UInt16 (default : 256);
        //Broadcast消息分器线程数量，仅用于Client中
        BroadcastDispatcherNum : UInt8 (default : 4);
        //Broadcast消息分发器缓存深度
        BroadcastDispatcherBufferLength : UInt16 (default : 256);

        //使能Posix环境下接收线程实时调度
        EnablePosixRealtimeSched : Boolean (default : false);
        //Posix环境下接收线程的优先级
        PosixRouterPriority : UInt8 (default : 20);

        //接收消息的轮询次数，轮询结束后转为阻塞等待，默认为0，即不轮询
        RcvMsgPollingTimes : UInt32 (default : 0);
    }
    // 一个provider可以包含多个instance，每个instance对应于一个interface。
    // 同一provider下，同一个interface只可对应一个instance。
    for instances {
        //仅当ProviderType为Client时设置有效，为Server时设置无效
        DstEndID : { CPU_0,CPU_1, CPU_2, CPU_3, CPU_4, CPU_5, CPU_6, CPU_7, CPUMP2_0, CPUMP2_1, ISPCV_0, ISPCV_1, ISPCV_2, ISPCV_3, ISPCV_4, NET_0, DMA_0, DMA_1, SWITCH_0, SWITCH_1, SWITCH_2, SWITCH_3, SWITCH_4, SWITCH_5, SECURE_0, SECURE_1, SAFETY_0, SAFETY_1, REALTIME_0, REALTIME_1, REALTIME_2, REALTIME_3, REALTIME_4, REALTIME_5, MEDIA_0} (optional);

        //是否为Server代码生成独立的reply函数，默认为true。
        GenerateReplyMethod : Boolean (default : true);
        NotUseSwitchCase : Boolean (default : false);
    }
    for interfaces {
        //是否将参数MaxMethodNum与MaxBroadcastNum作为ID有效值检查的条件，默认为true。
        //为false时，MethodID及BroadcastID有效范围为0-255
        EnableSection : Boolean (default : true);
        //最大支持的Method数量
        MaxMethodNum : UInt8 (default : 255);
        //最大支持的Broadcast数量
        MaxBroadcastNum : UInt8 (default : 20);
    }
    
    for methods {
        //该Method对应的CMD值。
        //EnableSection = true时，范围为0-(MaxMethodNum - 1)，否则为0-255
        //需要保证在同一个End内, MethodID值唯一。
        MethodID : UInt8;
    }
    
    for broadcasts {
        //broadcast的订阅方法ID，与MethodID统一编号
        //EnableSection = true时，范围为MaxMethodNum-255，否则为0-255
        SubscribeMethodID : UInt8;
        //broadcast的订阅方法ID，与MethodID统一编号
        //EnableSection = true时，范围为MaxMethodNum-255，否则为0-255
        UnsubscribeMethodID : UInt8;
        //broadcast对应的CMD值，独立编号，范围为0-MaxBroadcastNum 
        BroadcastID : UInt8;
        //broadcast的最大订阅数
        //MaxSubscribeNum : UInt8 (default : 34);
    }
}
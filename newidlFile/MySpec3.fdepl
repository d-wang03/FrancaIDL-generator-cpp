import "../newidlFile/MySpec2.fdepl"

specification MySpec3 extends MySpec2{

	for arrays {
		ArrayProp : Integer;
	}

	for maps {
		MapProp : Integer (optional);
	}

	for map_keys{
        KeyProp : Boolean;
	}

	for map_values{
        ValueProp : Boolean;
	}

	for structs {
		StructProp : Integer;
	}
	
	for struct_fields {
		SFieldProp : Integer;
	}

	for unions {
		UnionProp : Integer;
	}
	
	for union_fields {
		UFieldProp : Integer;
	}
	
	for typedefs {
		TypedefProp : Integer;
	}
    
	for floats{
        FloatProp : Integer;
	}
}
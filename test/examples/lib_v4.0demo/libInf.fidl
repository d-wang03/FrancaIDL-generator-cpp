
package com.bst.os.idl.libtest
import com.bst.os.idl.libtest.libTypes.* from "types.fidl"

interface libInf {
    version { major 4 minor 0 }

    attribute Staff[] Staffs
    attribute UInt64 staffSize
    attribute UInt64 staffCapacity
    typedef ID is UInt64

    method GetStaffStatus
    {
        in {
            UInt64 staffID
        }
        out {
            StaffStatus status
        }
    }
    method isNewStaff
    {
        in {
            UInt64 staffID
        }
        out {
            Boolean isNew
        }
    }
    method addNewStaff
    {
        in {
            ID staffID
            StaffInfor infor
        }
        out {
            Boolean ifSuccess
        }
    }
    method isOff
    {
        in {
            UInt64 staffID
        }
        out {
            Boolean isOff
        }
    }
    method getGrade
    {
        in {
            UInt64 staffID
        }
        out {
            Boolean isOff
        }
    }
    method getEmailAndPhoneCall
    {
        in {
            UInt64 staffID
        }
        out {
            ByteBuffer email
            ByteBuffer phoneCall
        }
    }

    method getSpecifiedGradesStaffs
    {
        in {
            Grade[] grades
        }
        out {
            Staff[] staffs
        }
    }
    method getSpecifiedGradesStaffEmails
    {
        in {
            Grade[] grades
        }
        out {
            ByteBuffer[] email
        }
    }
    method getAllEmails
    {
        out {
            ByteBuffer[] emails
        }
    }
    method getAllOffStaffs
    {
        out {
            ID[] staffIDs
        }
    }
}

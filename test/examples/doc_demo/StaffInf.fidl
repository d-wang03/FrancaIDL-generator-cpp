
package com.bst.os.idl.doctest
import com.bst.os.idl.doctest.staffTypes.* from "types.fidl"

<** @description : Sample IDL, showing how to use BST HTML File generator.
    @author : Tong Liu **>
interface staffInf {
    version { major 4 minor 0 }

	<** @description : A staff array to store each staff information. **>
    attribute Staff[] Staffs

	<** @description : A UInt64 type var to record size of array attribute "Staffs". **>
    attribute UInt64 staffSize

	<** @description : A UInt64 type var to record capacity of array attribute "Staffs". **>
    attribute UInt64 staffCapacity

	<** @description : A typedef var to to define alias name of UInt64. **>
    typedef ID is UInt64

	<** @description : A method to get status of a staff whose ID equals with the staffID. **>
    method GetStaffStatus
    {
        in {
            UInt64 staffID
        }
        out {
            StaffStatus status
        }
    }

	<** @description : A method to judge if the staffID has been used by existing staffs. **>
    method isNewStaff
    {
        in {
            UInt64 staffID
        }
        out {
            Boolean isNew
        }
    }

	<** @description : A method adding new staff to existing staffs. **>
    method addNewStaff
    {
        in {
            ID staffID
            StaffInfor infor
        }
        out {
            Boolean ifSuccess
        }
    }

	<** @description : A method to judge if the staff is off. **>
    method isOff
    {
        in {
            UInt64 staffID
        }
        out {
            Boolean isOff
        }
    }

	<** @description : A method to get grade of a staff with the ID . **>
    method getGrade
    {
        in {
            UInt64 staffID
        }
        out {
            Grade grade
        }
    }

	<** @description : A method to get email and phone call of a staff with the ID . **>
    method getEmailAndPhoneCall
    {
        in {
            UInt64 staffID
        }
        out {
            ByteBuffer email
            ByteBuffer phoneCall
        }
    }

	<** @description : A method to get staffs getting the grades . **>
    method getSpecifiedGradesStaffs
    {
        in {
            Grade[] grades
        }
        out {
            Staff[] staffs
        }
    }

	<** @description : A method to get emails of staffs getting the grades . **>
    method getSpecifiedGradesStaffEmails
    {
        in {
            Grade[] grades
        }
        out {
            ByteBuffer[] email
        }
    }

	<** @description : A method to get emails of all the staffs. **>
    method getAllEmails
    {
        out {
            ByteBuffer[] emails
        }
    }

	<** @description : A method to get staffIDs of the staffs who is off. **>
    method getAllOffStaffs
    {
        out {
            ID[] staffIDs
        }
    }
}
